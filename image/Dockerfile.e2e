FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git openssh-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
# Chromium and its system deps come from the same layer as the pip install
RUN pip install --no-cache-dir -r requirements.txt pytest pytest-playwright httpx \
    && playwright install chromium --with-deps

COPY app/ ./
COPY tests/ tests/

CMD ["python", "-m", "pytest", "tests/e2e/", "-v", "--tb=short", "--browser", "chromium"]
